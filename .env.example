# Login button target. Empty shows the button disabled.
NEXT_PUBLIC_LOGIN_URL=
# Where the Contact and Request a Demo forms POST. Empty shows the form's failure message.
NEXT_PUBLIC_FORM_ENDPOINT=
# Admin content API base URL. Empty shows the seed content in lib/content/seed.
CONTENT_API_URL=
# Hostname that serves images uploaded through the admin panel.
MEDIA_HOST=
